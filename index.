        let selectedCategory = 'all';
        let selectedTimeRange = 'all';

        function setMode(cat) {
            selectedCategory = cat;
            document.querySelectorAll('.mode-tab').forEach(btn => {
                btn.classList.remove('bg-brand-600', 'text-white');
                btn.classList.add('bg-slate-800', 'text-slate-400');
            });
            event.currentTarget.classList.remove('bg-slate-800', 'text-slate-400');
            event.currentTarget.classList.add('bg-brand-600', 'text-white');
            renderTickets();
        }

        function selectTimeFilter(range) {
            selectedTimeRange = range;
            document.querySelectorAll('.time-filter-btn').forEach(btn => {
                btn.classList.remove('bg-brand-600', 'text-white', 'border-brand-500');
                btn.classList.add('bg-slate-950', 'text-slate-300', 'border-slate-800');
            });
            
            const activeBtnMap = {
                'all': 'btn-time-all',
                '06:00-12:00': 'btn-time-1',
                '12:00-18:00': 'btn-time-2',
                '18:00-24:00': 'btn-time-3',
                '00:00-06:00': 'btn-time-4'
            };
            
            const activeId = activeBtnMap[range];
            if(activeId) {
                const el = document.getElementById(activeId);
                el.classList.remove('bg-slate-950', 'text-slate-300', 'border-slate-800');
                el.classList.add('bg-brand-600', 'text-white', 'border-brand-500');
            }
            renderTickets();
        }

        function isTimeInSelectedRange(depTimeStr, range) {
            if (range === 'all') return true;
            const hour = parseInt(depTimeStr.split(':')[0], 10);
            
            if (range === '06:00-12:00') return hour >= 6 && hour < 12;
            if (range === '12:00-18:00') return hour >= 12 && hour < 18;
            if (range === '18:00-24:00') return hour >= 18 && hour <= 23;
            if (range === '00:00-06:00') return hour >= 0 && hour < 6;
            return true;
        }

        function updateCounts(filteredBase) {
            let cAll = 0, c1 = 0, c2 = 0, c3 = 0, c4 = 0;
            
            filteredBase.forEach(t => {
                if(t.available) {
                    const seats = t.seats;
                    cAll += seats;
                    const hour = parseInt(t.depTime.split(':')[0], 10);
                    if (hour >= 6 && hour < 12) c1 += seats;
                    else if (hour >= 12 && hour < 18) c2 += seats;
                    else if (hour >= 18 && hour <= 23) c3 += seats;
                    else if (hour >= 0 && hour < 6) c4 += seats;
                }
            });

            document.getElementById('cnt-all').innerText = `(${cAll})`;
            document.getElementById('cnt-1').innerText = `(${c1})`;
            document.getElementById('cnt-2').innerText = `(${c2})`;
            document.getElementById('cnt-3').innerText = `(${c3})`;
            document.getElementById('cnt-4').innerText = `(${c4})`;
        }

        function updateRouteSummaryBox(filteredList) {
            const container = document.getElementById('available-bus-tags');
            
            let allBusNames = [];
            filteredList.forEach(t => {
                if(t.available) {
                    t.buses.forEach(b => {
                        if(!allBusNames.includes(b.name)) {
                            allBusNames.push(b.name);
                        }
                    });
                }
            });

            if (allBusNames.length === 0) {
                container.innerHTML = `<span class="text-slate-500 text-xs italic">Tidak ada armada bus tersedia untuk filter saat ini.</span>`;
            } else {
                container.innerHTML = allBusNames.map(name => `
                    <span class="bg-brand-500/10 text-brand-300 border border-brand-500/30 text-xs font-semibold px-2.5 py-1 rounded-lg">
                        <i class="fa-solid fa-check text-[10px] text-emerald-400 mr-1"></i>${name}
                    </span>
                `).join('');
            }
        }

        function renderTickets() {
            const container = document.getElementById('tickets-container');
            const origin = document.getElementById('origin-select').value;
            const dest = document.getElementById('dest-select').value;
            const statusFilter = document.getElementById('status-select').value;
            const busSearch = document.getElementById('bus-search').value.toLowerCase().trim();

            let baseFiltered = ticketData.filter(t => {
                const matchCat = (selectedCategory === 'all' || t.category === selectedCategory);
                const matchOrigin = (origin === 'all' || t.origin.toLowerCase().includes(origin.toLowerCase()));
                const matchDest = (dest === 'all' || t.dest.toLowerCase().includes(dest.toLowerCase()));
                return matchCat && matchOrigin && matchDest;
            });

            updateCounts(baseFiltered);
            updateRouteSummaryBox(baseFiltered);

            let filtered = baseFiltered.filter(t => {
                const matchStatus = (statusFilter === 'all' || (statusFilter === 'available' && t.available) || (statusFilter === 'soldout' && !t.available));
                const matchTime = isTimeInSelectedRange(t.depTime, selectedTimeRange);
                
                const busNamesConcat = t.buses.map(b => b.name).join(' ').toLowerCase();
                const matchSearch = busSearch === '' || busNamesConcat.includes(busSearch);
                
                return matchStatus && matchTime && matchSearch;
            });

            const countAvailable = ticketData.filter(t => t.available).length;
            const countSoldOut = ticketData.filter(t => !t.available).length;
            document.getElementById('stat-available').innerText = `${countAvailable} Rute`;
            document.getElementById('stat-soldout').innerText = `${countSoldOut} Rute`;
            document.getElementById('total-count-badge').innerText = `${filtered.length} Jadwal Ditemukan`;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center space-y-2">
                        <i class="fa-solid fa-folder-open text-3xl text-slate-600"></i>
                        <p class="text-sm font-bold text-slate-300">Tidak ada jadwal yang cocok dengan filter Anda.</p>
                        <p class="text-xs text-slate-500">Coba ubah opsi pencarian PO bus, rentang jam keberangkatan, atau tanggal.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = filtered.map(t => {
                const isBusCategory = t.category === 'bus' || t.category === 'shuttle';
                const typeIcon = isBusCategory ? 'fa-bus text-amber-400' : 'fa-train text-emerald-400';
                
                const busBadges = t.buses.map(b => `
                    <a href="${b.link}" target="_blank" class="bg-slate-800 hover:bg-brand-600 hover:text-white border border-slate-700/80 text-slate-200 text-[11px] font-semibold px-2.5 py-1 rounded-lg flex items-center gap-1.5 transition group">
                        <i class="fa-solid ${typeIcon} text-[10px]"></i>
                        <span>${b.name}</span>
                        <i class="fa-solid fa-arrow-up-right-from-square text-[9px] opacity-60 group-hover:opacity-100"></i>
                    </a>
                `).join('');

                if (t.available) {
                    return `
                        <div class="bg-slate-900 hover:bg-slate-850 border-2 border-emerald-500/40 hover:border-emerald-500 rounded-2xl p-5 transition shadow-lg flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div class="space-y-3">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="${t.platformColor} text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">Ref: ${t.platform}</span>
                                    <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> TERSEDIA (${t.seats} KURSI SISA)
                                    </span>
                                </div>
                                
                                <div class="flex items-center gap-3">
                                    <i class="fa-regular fa-clock text-brand-500 text-lg"></i>
                                    <h3 class="font-extrabold text-2xl text-white font-['Space_Grotesk'] tracking-tight">${t.depTime} <span class="text-slate-500 font-normal text-lg">&rarr;</span> ${t.arrTime}</h3>
                                    <span class="text-xs text-slate-400 bg-slate-950 px-2.5 py-1 rounded-md border border-slate-800">${t.origin} &rarr; ${t.dest}</span>
                                </div>

                                <div class="space-y-1">
                                    <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Pilih Bus / Armada Tersedia (Klik untuk Pesan):</span>
                                    <div class="flex flex-wrap gap-1.5 pt-0.5">
                                        ${busBadges}
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 border-t md:border-t-0 pt-3 md:pt-0 border-slate-800 justify-between md:justify-end">
                                <div class="text-left md:text-right">
                                    <span class="text-[10px] text-slate-400 block">Mulai Dari (${t.platform}):</span>
                                    <span class="text-xl font-extrabold text-brand-400 font-['Space_Grotesk']">${t.price}</span>
                                </div>
                                <a href="${t.link}" target="_blank" class="${t.btnBg} text-xs px-5 py-3 rounded-xl shadow-md transition flex items-center gap-2 shrink-0">
                                    <span>Buka di ${t.platform}</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    `;
                } else {
                    return `
                        <div class="bg-slate-950/60 border border-rose-500/30 rounded-2xl p-5 transition opacity-75 flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div class="space-y-3">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="bg-slate-800 text-slate-400 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase">Ref: ${t.platform}</span>
                                    <span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">
                                        🔴 HABIS (SOLD OUT)
                                    </span>
                                </div>
                                
                                <div class="flex items-center gap-3">
                                    <i class="fa-regular fa-clock text-slate-600 text-lg"></i>
                                    <h3 class="font-extrabold text-2xl text-slate-400 font-['Space_Grotesk'] tracking-tight line-through">${t.depTime} &rarr; ${t.arrTime}</h3>
                                    <span class="text-xs text-slate-500 bg-slate-950 px-2.5 py-1 rounded-md border border-slate-800">${t.origin} &rarr; ${t.dest}</span>
                                </div>

                                <div class="space-y-1">
                                    <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500">Armada pada Jam Ini:</span>
                                    <div class="flex flex-wrap gap-1.5 pt-0.5 opacity-60">
                                        ${busBadges}
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 border-t md:border-t-0 pt-3 md:pt-0 border-slate-800/50 justify-between md:justify-end">
                                <div class="text-left md:text-right">
                                    <span class="text-[10px] text-slate-500 block">Harga Terakhir:</span>
                                    <span class="text-xl font-bold text-slate-500 font-['Space_Grotesk']">${t.price}</span>
                                </div>
                                <button disabled class="bg-slate-800 text-slate-500 font-bold text-xs px-5 py-3 rounded-xl cursor-not-allowed flex items-center gap-1.5 shrink-0">
                                    <i class="fa-solid fa-ban text-xs"></i>
                                    <span>HABIS / SOLD OUT</span>
                                </button>
                            </div>
                        </div>
                    `;
                }
            }).join('');
        }

        // SIMULATOR AUTO-SYNC REAL-TIME DATA (Setiap 7 Detik)
        function startRealTimeSync() {
            setInterval(() => {
                const randomIndex = Math.floor(Math.random() * ticketData.length);
                const item = ticketData[randomIndex];

                if (item.available) {
                    if (item.seats > 1) {
                        item.seats -= 1;
                    } else {
                        item.available = false;
                        item.seats = 0;
                    }
                } else {
                    item.available = true;
                    item.seats = Math.floor(Math.random() * 5) + 1;
                }

                const now = new Date();
                const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB';
                document.getElementById('last-sync-time').innerText = timeStr;

                renderTickets();
            }, 7000);
        }

        // Init Tanggal Awal (2026-11-07)
        document.getElementById('travel-date').value = "2026-11-07";
        updateDateDisplay();
        renderTickets();
        startRealTimeSync();
    </script>
