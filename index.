<!DOCTYPE html>
<html lang="id" class="scroll-smooth font-sans">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TitikTemu.id - Real-Time Multi-Platform Ticket Radar</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            500: '#10b981',
                            600: '#059669',
                            800: '#065f46',
                            900: '#022c22',
                            950: '#011711',
                        },
                        accent: {
                            gold: '#f59e0b',
                            rose: '#f43f5e',
                            blue: '#3b82f6',
                        }
                    },
                    animation: {
                        'pulse-fast': 'pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'spin-slow': 'spin 8s linear infinite',
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-brand-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-brand-500 selection:text-white antialiased">

    <!-- Top Live Ticker Bar -->
    <div class="bg-gradient-to-r from-brand-900 via-brand-800 to-brand-900 border-b border-brand-800/50 py-2 px-4 text-xs">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold px-2.5 py-0.5 rounded-full text-[10px] tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse-fast"></span> REAL-TIME RADAR
                </span>
                <span class="text-slate-300">Menyinkronkan status stok tiket langsung dari Traveloka, Tiket.com, RedBus, & KAI Access.</span>
            </div>
            <div class="flex items-center gap-2 text-slate-400 text-[11px]">
                <i class="fa-solid fa-arrows-rotate animate-spin text-brand-500"></i>
                <span>Pembaruan Otomatis: <b id="last-sync-time" class="text-slate-200">Baru Saja</b></span>
            </div>
        </div>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 bg-brand-950/80 backdrop-blur-xl border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="window.scrollTo({top:0, behavior:'smooth'})">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-accent-gold flex items-center justify-center text-brand-950 font-black shadow-lg shadow-brand-500/20">
                    <i class="fa-solid fa-radar text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-xl tracking-tight text-white font-['Space_Grotesk']">TitikTemu<span class="text-brand-500">.id</span></span>
                        <span class="bg-brand-500/10 text-brand-400 text-[10px] font-extrabold px-2 py-0.5 rounded-md border border-brand-500/20 uppercase tracking-widest">LIVE TRACKER</span>
                    </div>
                    <p class="text-[10px] text-slate-400 tracking-wide">Monitoring Stok Transportasi Platform Luar</p>
                </div>
            </div>

            <!-- Stats & Quick Actions -->
            <div class="flex items-center gap-4">
                <div class="hidden sm:flex items-center gap-6 text-xs bg-slate-900/80 px-4 py-2 rounded-xl border border-slate-800">
                    <div>
                        <span class="text-slate-400 block text-[10px]">TERDAPAT STOK</span>
                        <span id="stat-available" class="font-extrabold text-emerald-400 text-sm">--</span>
                    </div>
                    <div class="w-px h-6 bg-slate-800"></div>
                    <div>
                        <span class="text-slate-400 block text-[10px]">HABIS (SOLD OUT)</span>
                        <span id="stat-soldout" class="font-extrabold text-rose-400 text-sm">--</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
        
        <!-- HERO BANNER -->
        <div class="relative rounded-3xl bg-gradient-to-r from-brand-900 via-slate-900 to-brand-950 p-6 sm:p-10 border border-slate-800 overflow-hidden shadow-2xl">
            <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="relative z-10 space-y-4 max-w-3xl">
                <div class="inline-flex items-center gap-2 bg-slate-800/80 border border-slate-700/60 rounded-full px-3 py-1 text-xs text-brand-400">
                    <i class="fa-solid fa-bolt text-accent-gold"></i>
                    <span>Cari Tiket Langka Mudik & Liburan Hari Ini</span>
                </div>
                <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight font-['Space_Grotesk'] leading-tight">
                    Pantau Sisa Tiket Platform Lain <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-emerald-300 to-accent-gold">Secara Real-Time.</span>
                </h1>
                <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
                    Sistem otomatis mengecek sisa ketersediaan tiket dari <b>Traveloka, Tiket.com, RedBus, Pegipegi, & KAI Access</b>. Jika stok tersedia, Anda bisa langsung mengklik link untuk memesan di platform terkait.
                </p>
            </div>
        </div>

        <!-- SEARCH FORM CARD -->
        <section class="bg-slate-900/90 rounded-2xl p-6 border border-slate-800 shadow-xl backdrop-blur-md space-y-6">
            
            <!-- Category Tabs -->
            <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-800">
                <button type="button" onclick="setMode('all')" class="mode-tab active bg-brand-600 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition flex items-center gap-2 shrink-0">
                    <i class="fa-solid fa-cubes"></i> Semua Moda
                </button>
                <button type="button" onclick="setMode('bus')" class="mode-tab bg-slate-800 text-slate-400 hover:text-white font-bold text-xs px-4 py-2.5 rounded-xl transition flex items-center gap-2 shrink-0">
                    <i class="fa-solid fa-bus text-amber-500"></i> Bus AKAP
                </button>
                <button type="button" onclick="setMode('train')" class="mode-tab bg-slate-800 text-slate-400 hover:text-white font-bold text-xs px-4 py-2.5 rounded-xl transition flex items-center gap-2 shrink-0">
                    <i class="fa-solid fa-train text-emerald-400"></i> Kereta Api (KAI)
                </button>
                <button type="button" onclick="setMode('shuttle')" class="mode-tab bg-slate-800 text-slate-400 hover:text-white font-bold text-xs px-4 py-2.5 rounded-xl transition flex items-center gap-2 shrink-0">
                    <i class="fa-solid fa-van-shuttle text-blue-400"></i> Travel / Shuttle
                </button>
            </div>

            <!-- Form Controls -->
            <form id="search-form" onsubmit="event.preventDefault(); renderTickets();" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4">
                
                <div class="lg:col-span-4 space-y-1.5">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Kota Keberangkatan</label>
                    <div class="relative">
                        <i class="fa-solid fa-location-dot absolute left-4 top-1/2 -translate-y-1/2 text-brand-500"></i>
                        <select id="origin-select" class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-11 pr-4 py-3 text-sm text-white font-medium focus:outline-none focus:border-brand-500 transition">
                            <option value="all">Semua Kota Asal</option>
                            <option value="Jakarta">Jakarta (Semua Terminal/Stasiun)</option>
                            <option value="Bandung">Bandung</option>
                            <option value="Surabaya">Surabaya</option>
                            <option value="Semarang">Semarang</option>
                        </select>
                    </div>
                </div>

                <div class="lg:col-span-4 space-y-1.5">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Kota Tujuan</label>
                    <div class="relative">
                        <i class="fa-solid fa-flag absolute left-4 top-1/2 -translate-y-1/2 text-accent-gold"></i>
                        <select id="dest-select" class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-11 pr-4 py-3 text-sm text-white font-medium focus:outline-none focus:border-brand-500 transition">
                            <option value="all">Semua Kota Tujuan</option>
                            <option value="Yogyakarta">Yogyakarta / Solo</option>
                            <option value="Surabaya">Surabaya</option>
                            <option value="Semarang">Semarang / Kudus</option>
                            <option value="Malang">Malang</option>
                        </select>
                    </div>
                </div>

                <div class="lg:col-span-4 space-y-1.5">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Filter Status Stok</label>
                    <div class="relative">
                        <i class="fa-solid fa-filter absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <select id="status-select" onchange="renderTickets()" class="w-full bg-slate-950 border border-slate-800 rounded-xl pl-11 pr-4 py-3 text-sm text-white font-medium focus:outline-none focus:border-brand-500 transition">
                            <option value="all">Tampilkan Semua (Tersedia & Habis)</option>
                            <option value="available">🟢 Hanya yang TERSEDIA</option>
                            <option value="soldout">🔴 Hanya yang HABIS (Sold Out)</option>
                        </select>
                    </div>
                </div>

            </form>
        </section>

        <!-- LIVE TICKET MONITORING RESULTS -->
        <section class="space-y-4">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <h2 class="text-xl font-bold text-white font-['Space_Grotesk']">Daftar Pantauan Tiket Real-Time</h2>
                    <span id="total-count-badge" class="bg-brand-500/10 text-brand-400 text-xs font-bold px-2.5 py-1 rounded-full border border-brand-500/20">-- Rute</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-400">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span> Live Auto-Sync Active
                </div>
            </div>

            <!-- Container Tiket -->
            <div id="tickets-container" class="space-y-3">
                <!-- Tiket injected via JS -->
            </div>

        </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-slate-950 border-t border-slate-800 py-6 text-xs text-slate-500 text-center">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-lg bg-brand-500 text-brand-950 flex items-center justify-center font-bold">
                    <i class="fa-solid fa-radar text-xs"></i>
                </div>
                <span class="font-bold text-slate-300">TitikTemu.id</span>
            </div>
            <p>&copy; 2026 TitikTemu.id — Multi-Platform Real-Time Ticket Stock Radar.</p>
        </div>
    </footer>

    <!-- REAL-TIME JAVASCRIPT LOGIC -->
    <script>
        // Database Simulasi Platform Luar (Real-Time Dynamic Data)
        let ticketData = [
            {
                id: 1,
                operator: "Sinar Jaya Executive",
                category: "bus",
                origin: "Jakarta",
                dest: "Yogyakarta",
                depTime: "07:30 WIB",
                arrTime: "16:30 WIB",
                price: "Rp 480.000",
                platform: "Traveloka",
                platformColor: "bg-blue-600 text-white",
                btnBg: "bg-blue-600 hover:bg-blue-700 text-white",
                link: "https://www.traveloka.com/id-id/bus-and-shuttle",
                available: true,
                seats: 4
            },
            {
                id: 2,
                operator: "Argo Lawu Executive",
                category: "train",
                origin: "Jakarta",
                dest: "Yogyakarta",
                depTime: "08:00 WIB",
                arrTime: "14:00 WIB",
                price: "Rp 650.000",
                platform: "KAI Access",
                platformColor: "bg-orange-600 text-white",
                btnBg: "bg-orange-600 hover:bg-orange-700 text-white",
                link: "https://booking.kai.id",
                available: false,
                seats: 0
            },
            {
                id: 3,
                operator: "Sumber Alam Sleeper Bus",
                category: "bus",
                origin: "Jakarta",
                dest: "Yogyakarta",
                depTime: "18:30 WIB",
                arrTime: "04:00 WIB",
                price: "Rp 520.000",
                platform: "Tiket.com",
                platformColor: "bg-amber-400 text-slate-950",
                btnBg: "bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold",
                link: "https://www.tiket.com/bus-travel",
                available: true,
                seats: 2
            },
            {
                id: 4,
                operator: "DayTrans Executive Shuttle",
                category: "shuttle",
                origin: "Bandung",
                dest: "Surabaya",
                depTime: "10:00 WIB",
                arrTime: "21:00 WIB",
                price: "Rp 350.000",
                platform: "RedBus",
                platformColor: "bg-rose-600 text-white",
                btnBg: "bg-rose-600 hover:bg-rose-700 text-white",
                link: "https://www.redbus.id",
                available: true,
                seats: 7
            },
            {
                id: 5,
                operator: "Taksaka Luxury Train",
                category: "train",
                origin: "Jakarta",
                dest: "Yogyakarta",
                depTime: "21:00 WIB",
                arrTime: "03:30 WIB",
                price: "Rp 1.200.000",
                platform: "Pegipegi / KAI",
                platformColor: "bg-teal-600 text-white",
                btnBg: "bg-teal-600 hover:bg-teal-700 text-white",
                link: "https://booking.kai.id",
                available: false,
                seats: 0
            }
        ];

        let selectedCategory = 'all';

        function setMode(cat) {
            selectedCategory = cat;
            document.querySelectorAll('.mode-tab').forEach(btn => {
                btn.classList.remove('bg-brand-600', 'text-white');
                btn.classList.add('bg-slate-800', 'text-slate-400');
            });
            event.currentTarget.classList.remove('bg-slate-800', 'text-slate-400');
            event.currentTarget.classList.add('bg-brand-600', 'text-white');
            renderTickets();
        }

        function renderTickets() {
            const container = document.getElementById('tickets-container');
            const origin = document.getElementById('origin-select').value;
            const dest = document.getElementById('dest-select').value;
            const statusFilter = document.getElementById('status-select').value;

            let filtered = ticketData.filter(t => {
                const matchCat = (selectedCategory === 'all' || t.category === selectedCategory);
                const matchOrigin = (origin === 'all' || t.origin.toLowerCase().includes(origin.toLowerCase()));
                const matchDest = (dest === 'all' || t.dest.toLowerCase().includes(dest.toLowerCase()));
                const matchStatus = (statusFilter === 'all' || (statusFilter === 'available' && t.available) || (statusFilter === 'soldout' && !t.available));
                return matchCat && matchOrigin && matchDest && matchStatus;
            });

            // Update stats
            const countAvailable = ticketData.filter(t => t.available).length;
            const countSoldOut = ticketData.filter(t => !t.available).length;
            document.getElementById('stat-available').innerText = `${countAvailable} Rute`;
            document.getElementById('stat-soldout').innerText = `${countSoldOut} Rute`;
            document.getElementById('total-count-badge').innerText = `${filtered.length} Rute Ditemukan`;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center space-y-2">
                        <i class="fa-solid fa-folder-open text-3xl text-slate-600"></i>
                        <p class="text-sm font-bold text-slate-300">Tidak ada rute yang cocok dengan filter Anda.</p>
                        <p class="text-xs text-slate-500">Coba ubah opsi kota asal, tujuan, atau kategori transportasi.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = filtered.map(t => {
                if (t.available) {
                    return `
                        <div class="bg-slate-900 hover:bg-slate-850 border-2 border-emerald-500/40 hover:border-emerald-500 rounded-2xl p-5 transition shadow-lg flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div class="space-y-2">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="${t.platformColor} text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">Ref: ${t.platform}</span>
                                    <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> TERSEDIA (${t.seats} KURSI SISA)
                                    </span>
                                </div>
                                <h3 class="font-bold text-lg text-white font-['Space_Grotesk']">${t.operator}</h3>
                                <p class="text-xs text-slate-400 flex items-center gap-2">
                                    <span><i class="fa-regular fa-clock text-brand-500 mr-1"></i> Keberangkatan: <b>${t.depTime}</b></span>
                                    <span>•</span>
                                    <span>${t.origin} &rarr; ${t.dest}</span>
                                </p>
                            </div>
                            <div class="flex items-center gap-4 border-t md:border-t-0 pt-3 md:pt-0 border-slate-800 justify-between md:justify-end">
                                <div class="text-left md:text-right">
                                    <span class="text-[10px] text-slate-400 block">Harga di ${t.platform}:</span>
                                    <span class="text-xl font-extrabold text-brand-400 font-['Space_Grotesk']">${t.price}</span>
                                </div>
                                <a href="${t.link}" target="_blank" class="${t.btnBg} text-xs px-5 py-3 rounded-xl shadow-md transition flex items-center gap-2 shrink-0">
                                    <span>Buka di ${t.platform}</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    `;
                } else {
                    return `
                        <div class="bg-slate-950/60 border border-rose-500/30 rounded-2xl p-5 transition opacity-75 flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div class="space-y-2">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="bg-slate-800 text-slate-400 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase">Ref: ${t.platform}</span>
                                    <span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">
                                        🔴 HABIS (SOLD OUT)
                                    </span>
                                </div>
                                <h3 class="font-bold text-lg text-slate-400 line-through font-['Space_Grotesk']">${t.operator}</h3>
                                <p class="text-xs text-slate-500 flex items-center gap-2">
                                    <span><i class="fa-regular fa-clock text-slate-600 mr-1"></i> Keberangkatan: ${t.depTime}</span>
                                    <span>•</span>
                                    <span>${t.origin} &rarr; ${t.dest}</span>
                                </p>
                            </div>
                            <div class="flex items-center gap-4 border-t md:border-t-0 pt-3 md:pt-0 border-slate-800/50 justify-between md:justify-end">
                                <div class="text-left md:text-right">
                                    <span class="text-[10px] text-slate-500 block">Harga Terakhir:</span>
                                    <span class="text-xl font-bold text-slate-500 font-['Space_Grotesk']">${t.price}</span>
                                </div>
                                <button disabled class="bg-slate-800 text-slate-500 font-bold text-xs px-5 py-3 rounded-xl cursor-not-allowed flex items-center gap-1.5 shrink-0">
                                    <i class="fa-solid fa-ban text-xs"></i>
                                    <span>HABIS / SOLD OUT</span>
                                </button>
                            </div>
                        </div>
                    `;
                }
            }).join('');
        }

        // SIMULATOR AUTO-SYNC REAL-TIME DATA (Setiap 7 Detik)
        function startRealTimeSync() {
            setInterval(() => {
                // Pick random item to change status or seat count
                const randomIndex = Math.floor(Math.random() * ticketData.length);
                const item = ticketData[randomIndex];

                if (item.available) {
                    if (item.seats > 1) {
                        item.seats -= 1;
                    } else {
                        item.available = false;
                        item.seats = 0;
                    }
                } else {
                    // Coba buka kembali (simulasi ada pemudik yang batal/refund)
                    item.available = true;
                    item.seats = Math.floor(Math.random() * 3) + 1;
                }

                // Update UI timestamp & tickets
                const now = new Date();
                const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB';
                document.getElementById('last-sync-time').innerText = timeStr;

                renderTickets();
            }, 7000);
        }

        // Initial Render
        renderTickets();
        startRealTimeSync();
    </script>
</body>
</html>