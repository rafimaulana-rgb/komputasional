        // Array nama hari & bulan dalam Bahasa Indonesia
        const daysIndo = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
        const monthsIndo = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agust", "Sep", "Okt", "Nov", "Des"];

        function updateDateDisplay() {
            const dateVal = document.getElementById('travel-date').value;
            if (!dateVal) return;

            const parts = dateVal.split('-');
            const year = parseInt(parts[0], 10);
            const month = parseInt(parts[1], 10) - 1;
            const day = parseInt(parts[2], 10);
            
            const selectedDate = new Date(year, month, day);
            const dayName = daysIndo[selectedDate.getDay()];
            const monthName = monthsIndo[selectedDate.getMonth()];
            
            // Format seperti screenshot: "Sabtu, 07 Nov 2026"
            const formattedString = `${dayName}, ${day < 10 ? '0' + day : day} ${monthName} ${year}`;
            document.getElementById('date-display-text').innerText = formattedString;
        }

        function handleDateChange() {
            updateDateDisplay();
            renderTickets();
        }

        function setDatePreset(daysFromToday) {
            const baseDate = new Date(2026, 10, 7); // 7 Nov 2026
            baseDate.setDate(baseDate.getDate() + daysFromToday);
            
            const yyyy = baseDate.getFullYear();
            const mm = String(baseDate.getMonth() + 1).padStart(2, '0');
            const dd = String(baseDate.getDate()).padStart(2, '0');
            
            document.getElementById('travel-date').value = `${yyyy}-${mm}-${dd}`;
            updateDateDisplay();
            renderTickets();
